# EduCore Web · Variables de entorno (desarrollo)
# Solo las variables con prefijo VITE_ llegan al navegador: NUNCA pongas secretos en ellas.

# Ruta base de la API. Con el proxy de Vite (y en producción detrás del proxy inverso) es relativa.
VITE_API_BASE_URL=/api/v1

# Destino del proxy de desarrollo de Vite (no se expone al navegador).
API_PROXY_TARGET=http://127.0.0.1:3000
