// EduCore · Esquema de datos (PostgreSQL)
//
// Convenciones (ver docs/00-diagnostico-y-plan.md, sección 6):
// - PK uuid v7 generado por la aplicación; tablas y columnas en snake_case.
// - Toda entidad institucional lleva institution_id NOT NULL desde su primera
//   migración y sus restricciones únicas lo incluyen. Las tablas hijas que
//   heredan la institución de su padre (p. ej. academic_period → academic_year)
//   no repiten la columna. test/schema/tenancy.spec verifica estas reglas.
// - Fechas con hora en timestamptz; fechas de calendario en date.
// - ON DELETE RESTRICT por defecto; CASCADE solo en tablas puente puras.
// - Las entidades académicas y de personas no se borran: se archivan con status.
//
// La URL de conexión NO va aquí: el CLI la toma de prisma.config.ts
// (rol de migraciones) y la aplicación usa el driver adapter de pg (rol app).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Enums
// ============================================================================

enum InstitutionStatus {
  ACTIVE
  INACTIVE

  @@map("institution_status")
}

enum RecordStatus {
  ACTIVE
  INACTIVE

  @@map("record_status")
}

enum DocumentType {
  RC
  TI
  CC
  CE
  NUIP
  PPT
  PEP
  PA

  @@map("document_type")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED

  @@map("membership_status")
}

enum PermissionScope {
  ALL
  ASSIGNED
  OWN
  LINKED

  @@map("permission_scope")
}

enum PasswordTokenPurpose {
  ACTIVATION
  RESET

  @@map("password_token_purpose")
}

enum AcademicYearStatus {
  PLANNING
  ACTIVE
  CLOSED

  @@map("academic_year_status")
}

enum AcademicPeriodStatus {
  PLANNED
  OPEN
  CLOSED
  PUBLISHED

  @@map("academic_period_status")
}

enum StudentStatus {
  ACTIVE
  WITHDRAWN
  GRADUATED

  @@map("student_status")
}

enum GuardianRelationship {
  MOTHER
  FATHER
  GRANDPARENT
  SIBLING
  UNCLE_AUNT
  LEGAL_GUARDIAN
  OTHER

  @@map("guardian_relationship")
}

enum StaffType {
  TEACHER
  DIRECTIVE
  ADMINISTRATIVE
  SUPPORT

  @@map("staff_type")
}

/// Sensibilidad de un archivo: define quién puede descargarlo.
enum FileClassification {
  /// Material institucional (logo, documentos públicos de la institución).
  INSTITUTIONAL
  /// Datos personales (documentos de identidad, matrículas).
  PERSONAL
  /// Datos sensibles (soportes médicos de excusas): acceso más restringido.
  SENSITIVE

  @@map("file_classification")
}

// ============================================================================
// Institución
// ============================================================================

model Institution {
  id         String            @id @default(uuid(7)) @db.Uuid
  legalName  String            @map("legal_name") @db.VarChar(200)
  tradeName  String?           @map("trade_name") @db.VarChar(200)
  /// NIT sin dígito de verificación.
  taxId      String?           @map("tax_id") @db.VarChar(20)
  taxIdDv    String?           @map("tax_id_dv") @db.VarChar(1)
  /// Código DANE del establecimiento educativo.
  daneCode   String?           @map("dane_code") @db.VarChar(20)
  email      String?           @db.VarChar(254)
  phone      String?           @db.VarChar(40)
  website    String?           @db.VarChar(300)
  address    String?           @db.VarChar(300)
  city       String?           @db.VarChar(120)
  department String?           @db.VarChar(120)
  country    String            @default("CO") @db.Char(2)
  status     InstitutionStatus @default(ACTIVE)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  settings        InstitutionSettings?
  campuses        Campus[]
  shifts          Shift[]
  people          Person[]
  memberships     UserInstitution[]
  roles           Role[]
  auditLogs       AuditLog[]
  academicYears   AcademicYear[]
  educationLevels EducationLevel[]
  grades          Grade[]
  schoolGroups    SchoolGroup[]
  subjectAreas    SubjectArea[]
  subjects        Subject[]
  storedFiles     StoredFile[]
  students        Student[]
  guardians       Guardian[]
  staffMembers    StaffMember[]

  @@map("institution")
}

model InstitutionSettings {
  institutionId String   @id @map("institution_id") @db.Uuid
  timezone      String   @default("America/Bogota") @db.VarChar(64)
  locale        String   @default("es-CO") @db.VarChar(16)
  currency      String   @default("COP") @db.Char(3)
  /// { primaryColor, accentColor }. Validado en la API.
  branding      Json     @default("{}")
  /// Logo de la institución (archivo institucional).
  logoFileId    String?  @map("logo_file_id") @db.Uuid
  /// Preferencias de la plataforma. Validado en la API.
  preferences   Json     @default("{}")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  logoFile    StoredFile? @relation(fields: [logoFileId], references: [id], onDelete: SetNull)

  @@map("institution_settings")
}

model Campus {
  id            String       @id @default(uuid(7)) @db.Uuid
  institutionId String       @map("institution_id") @db.Uuid
  code          String       @db.VarChar(20)
  name          String       @db.VarChar(150)
  daneCode      String?      @map("dane_code") @db.VarChar(20)
  address       String?      @db.VarChar(300)
  city          String?      @db.VarChar(120)
  phone         String?      @db.VarChar(40)
  isMain        Boolean      @default(false) @map("is_main")
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  institution  Institution   @relation(fields: [institutionId], references: [id])
  schoolGroups SchoolGroup[]

  @@unique([institutionId, code])
  @@map("campus")
}

model Shift {
  id            String       @id @default(uuid(7)) @db.Uuid
  institutionId String       @map("institution_id") @db.Uuid
  code          String       @db.VarChar(20)
  name          String       @db.VarChar(100)
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  institution  Institution   @relation(fields: [institutionId], references: [id])
  schoolGroups SchoolGroup[]

  @@unique([institutionId, code])
  @@map("shift")
}

// ============================================================================
// Identidad y acceso
// ============================================================================

/// Cuenta de acceso GLOBAL (una por correo). Los datos personales viven en
/// Person, que es institucional; UserInstitution une ambos.
model User {
  id                  String    @id @default(uuid(7)) @db.Uuid
  email               String    @unique @db.Citext
  /// Argon2id. Nulo mientras la cuenta no se ha activado.
  passwordHash        String?   @map("password_hash") @db.VarChar(255)
  isActive            Boolean   @default(true) @map("is_active")
  failedLoginCount    Int       @default(0) @map("failed_login_count")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships    UserInstitution[]
  sessions       UserSession[]
  passwordTokens PasswordToken[]

  @@map("user")
}

/// Persona en el contexto de UNA institución (responsable del tratamiento de
/// sus datos según la Ley 1581). Una misma persona en dos colegios = dos filas.
model Person {
  id             String       @id @default(uuid(7)) @db.Uuid
  institutionId  String       @map("institution_id") @db.Uuid
  documentType   DocumentType @map("document_type")
  documentNumber String       @map("document_number") @db.VarChar(30)
  firstNames     String       @map("first_names") @db.VarChar(120)
  lastNames      String       @map("last_names") @db.VarChar(120)
  birthDate      DateTime?    @map("birth_date") @db.Date
  email          String?      @db.VarChar(254)
  phone          String?      @db.VarChar(40)
  address        String?      @db.VarChar(300)
  /// Nombres y documento normalizados (minúsculas, sin tildes) para buscar.
  /// Lo calcula un trigger de la base: no se escribe desde la aplicación.
  searchText     String?      @map("search_text")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  institution Institution      @relation(fields: [institutionId], references: [id])
  membership  UserInstitution?
  student     Student?
  guardian    Guardian?
  staff       StaffMember?

  @@unique([institutionId, documentType, documentNumber])
  @@index([institutionId, lastNames, firstNames])
  @@map("person")
}

/// Membresía: vincula una cuenta global con una institución y la persona que
/// representa en ella. Los roles se asignan a la membresía, no al usuario.
model UserInstitution {
  id            String           @id @default(uuid(7)) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  institutionId String           @map("institution_id") @db.Uuid
  personId      String           @unique @map("person_id") @db.Uuid
  status        MembershipStatus @default(INVITED)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User             @relation(fields: [userId], references: [id])
  institution Institution      @relation(fields: [institutionId], references: [id])
  person      Person           @relation(fields: [personId], references: [id])
  roles       MembershipRole[]
  sessions    UserSession[]

  @@unique([userId, institutionId])
  @@index([institutionId, status])
  @@map("user_institution")
}

model Role {
  id            String   @id @default(uuid(7)) @db.Uuid
  institutionId String   @map("institution_id") @db.Uuid
  code          String   @db.VarChar(50)
  name          String   @db.VarChar(100)
  description   String?  @db.VarChar(300)
  /// Rol de sistema: sus permisos los define el código y no son editables.
  isSystem      Boolean  @default(false) @map("is_system")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  institution Institution      @relation(fields: [institutionId], references: [id])
  permissions RolePermission[]
  memberships MembershipRole[]

  @@unique([institutionId, code])
  @@map("role")
}

/// Catálogo global de permisos, sincronizado desde @educore/shared.
model Permission {
  id          String @id @default(uuid(7)) @db.Uuid
  code        String @unique @db.VarChar(100)
  module      String @db.VarChar(50)
  description String @db.VarChar(300)

  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String          @map("role_id") @db.Uuid
  permissionId String          @map("permission_id") @db.Uuid
  scope        PermissionScope @default(ALL)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model MembershipRole {
  membershipId     String   @map("membership_id") @db.Uuid
  roleId           String   @map("role_id") @db.Uuid
  assignedAt       DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedByUserId String?  @map("assigned_by_user_id") @db.Uuid

  membership UserInstitution @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role            @relation(fields: [roleId], references: [id])

  @@id([membershipId, roleId])
  @@index([roleId])
  @@map("membership_role")
}

/// Sesión de refresh. El token solo se guarda como hash SHA-256. Todas las
/// sesiones rotadas desde un mismo login comparten family_id.
model UserSession {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  membershipId     String    @map("membership_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason    String?   @map("revoked_reason") @db.VarChar(40)
  ip               String?   @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.VarChar(300)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership UserInstitution @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("user_session")
}

/// Tokens de un solo uso para activar la cuenta o restablecer la contraseña.
model PasswordToken {
  id        String               @id @default(uuid(7)) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  purpose   PasswordTokenPurpose
  tokenHash String               @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime             @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?            @map("used_at") @db.Timestamptz(6)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("password_token")
}

/// Registro de auditoría de solo inserción (sin UPDATE/DELETE para educore_app).
/// institution_id es nulo solo en eventos sin institución resoluble (p. ej.
/// un intento de login con un correo inexistente).
model AuditLog {
  id            String   @id @default(uuid(7)) @db.Uuid
  institutionId String?  @map("institution_id") @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  action        String   @db.VarChar(80)
  entityType    String?  @map("entity_type") @db.VarChar(60)
  entityId      String?  @map("entity_id") @db.Uuid
  /// { campo: { from, to } } sin datos sensibles.
  changes       Json?
  metadata      Json?
  ip            String?  @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.VarChar(300)
  requestId     String?  @map("request_id") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// RESTRICT: la auditoría nunca pierde la institución a la que pertenece.
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@index([institutionId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_log")
}

// ============================================================================
// Estructura académica
// ============================================================================

model AcademicYear {
  id            String             @id @default(uuid(7)) @db.Uuid
  institutionId String             @map("institution_id") @db.Uuid
  year          Int
  name          String             @db.VarChar(100)
  startsOn      DateTime           @map("starts_on") @db.Date
  endsOn        DateTime           @map("ends_on") @db.Date
  status        AcademicYearStatus @default(PLANNING)
  version       Int                @default(0)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  institution  Institution      @relation(fields: [institutionId], references: [id])
  periods      AcademicPeriod[]
  schoolGroups SchoolGroup[]

  @@unique([institutionId, year])
  @@map("academic_year")
}

model AcademicPeriod {
  id             String               @id @default(uuid(7)) @db.Uuid
  academicYearId String               @map("academic_year_id") @db.Uuid
  number         Int
  name           String               @db.VarChar(100)
  startsOn       DateTime             @map("starts_on") @db.Date
  endsOn         DateTime             @map("ends_on") @db.Date
  weightPercent  Decimal              @map("weight_percent") @db.Decimal(5, 2)
  status         AcademicPeriodStatus @default(PLANNED)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([academicYearId, number])
  @@map("academic_period")
}

model EducationLevel {
  id            String       @id @default(uuid(7)) @db.Uuid
  institutionId String       @map("institution_id") @db.Uuid
  code          String       @db.VarChar(20)
  name          String       @db.VarChar(100)
  sortOrder     Int          @default(0) @map("sort_order")
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  institution Institution @relation(fields: [institutionId], references: [id])
  grades      Grade[]

  @@unique([institutionId, code])
  @@map("education_level")
}

model Grade {
  id               String       @id @default(uuid(7)) @db.Uuid
  institutionId    String       @map("institution_id") @db.Uuid
  educationLevelId String       @map("education_level_id") @db.Uuid
  code             String       @db.VarChar(20)
  name             String       @db.VarChar(100)
  sortOrder        Int          @default(0) @map("sort_order")
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  institution    Institution    @relation(fields: [institutionId], references: [id])
  educationLevel EducationLevel @relation(fields: [educationLevelId], references: [id])
  schoolGroups   SchoolGroup[]

  @@unique([institutionId, code])
  @@index([educationLevelId])
  @@map("grade")
}

model SchoolGroup {
  id             String       @id @default(uuid(7)) @db.Uuid
  institutionId  String       @map("institution_id") @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  gradeId        String       @map("grade_id") @db.Uuid
  campusId       String       @map("campus_id") @db.Uuid
  shiftId        String       @map("shift_id") @db.Uuid
  code           String       @db.VarChar(20)
  name           String       @db.VarChar(100)
  capacity       Int?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  institution  Institution  @relation(fields: [institutionId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  grade        Grade        @relation(fields: [gradeId], references: [id])
  campus       Campus       @relation(fields: [campusId], references: [id])
  shift        Shift        @relation(fields: [shiftId], references: [id])

  @@unique([institutionId, academicYearId, campusId, code])
  @@index([academicYearId, gradeId])
  @@map("school_group")
}

model SubjectArea {
  id            String       @id @default(uuid(7)) @db.Uuid
  institutionId String       @map("institution_id") @db.Uuid
  code          String       @db.VarChar(20)
  name          String       @db.VarChar(150)
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  institution Institution @relation(fields: [institutionId], references: [id])
  subjects    Subject[]

  @@unique([institutionId, code])
  @@map("subject_area")
}

model Subject {
  id            String       @id @default(uuid(7)) @db.Uuid
  institutionId String       @map("institution_id") @db.Uuid
  subjectAreaId String       @map("subject_area_id") @db.Uuid
  code          String       @db.VarChar(20)
  name          String       @db.VarChar(150)
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  institution Institution @relation(fields: [institutionId], references: [id])
  subjectArea SubjectArea @relation(fields: [subjectAreaId], references: [id])

  @@unique([institutionId, code])
  @@index([subjectAreaId])
  @@map("subject")
}

// ============================================================================
// Archivos
// ============================================================================

/// Metadatos de un archivo. El contenido vive en el almacenamiento privado
/// (driver local o S3), nunca en la base de datos. La clave de almacenamiento
/// la genera el servidor; el nombre original solo se guarda como dato.
model StoredFile {
  id               String             @id @default(uuid(7)) @db.Uuid
  institutionId    String             @map("institution_id") @db.Uuid
  storageDriver    String             @map("storage_driver") @db.VarChar(20)
  storageKey       String             @map("storage_key") @db.VarChar(300)
  originalName     String             @map("original_name") @db.VarChar(255)
  mimeType         String             @map("mime_type") @db.VarChar(100)
  sizeBytes        Int                @map("size_bytes")
  sha256           String             @db.Char(64)
  classification   FileClassification
  uploadedByUserId String?            @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  institution     Institution           @relation(fields: [institutionId], references: [id])
  logoOfSettings  InstitutionSettings[]

  @@unique([institutionId, storageKey])
  @@index([institutionId, createdAt(sort: Desc)])
  @@map("stored_file")
}

// ============================================================================
// Comunidad educativa
// ============================================================================

/// Perfil de estudiante de una persona. No se borra: cambia de estado.
model Student {
  id            String        @id @default(uuid(7)) @db.Uuid
  institutionId String        @map("institution_id") @db.Uuid
  personId      String        @unique @map("person_id") @db.Uuid
  /// Código institucional opcional (único en la institución cuando existe).
  code          String?       @db.VarChar(30)
  status        StudentStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  institution Institution       @relation(fields: [institutionId], references: [id])
  person      Person            @relation(fields: [personId], references: [id])
  guardians   StudentGuardian[]

  @@unique([institutionId, code])
  @@index([institutionId, status])
  @@map("student")
}

/// Perfil de acudiente de una persona.
model Guardian {
  id            String   @id @default(uuid(7)) @db.Uuid
  institutionId String   @map("institution_id") @db.Uuid
  personId      String   @unique @map("person_id") @db.Uuid
  occupation    String?  @db.VarChar(120)
  workplace     String?  @db.VarChar(150)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  institution Institution       @relation(fields: [institutionId], references: [id])
  person      Person            @relation(fields: [personId], references: [id])
  students    StudentGuardian[]

  @@index([institutionId])
  @@map("guardian")
}

/// Vínculo estudiante–acudiente. Un único acudiente principal por estudiante
/// (índice único parcial en la migración).
model StudentGuardian {
  studentId             String               @map("student_id") @db.Uuid
  guardianId            String               @map("guardian_id") @db.Uuid
  relationship          GuardianRelationship
  isPrimary             Boolean              @default(false) @map("is_primary")
  /// Representante legal: quien autoriza el tratamiento de datos del menor (Ley 1581, art. 7).
  isLegalRepresentative Boolean              @default(false) @map("is_legal_representative")
  livesWithStudent      Boolean              @default(false) @map("lives_with_student")
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@index([guardianId])
  @@map("student_guardian")
}

/// Personal de la institución (docentes, directivos, administrativos, apoyo).
model StaffMember {
  id            String       @id @default(uuid(7)) @db.Uuid
  institutionId String       @map("institution_id") @db.Uuid
  personId      String       @unique @map("person_id") @db.Uuid
  staffType     StaffType    @map("staff_type")
  /// Cargo (p. ej. "Docente de matemáticas", "Coordinador académico").
  title         String?      @db.VarChar(120)
  hireDate      DateTime?    @map("hire_date") @db.Date
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  institution Institution @relation(fields: [institutionId], references: [id])
  person      Person      @relation(fields: [personId], references: [id])

  @@index([institutionId, staffType, status])
  @@map("staff_member")
}
