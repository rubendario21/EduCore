# EduCore API · Variables de entorno (desarrollo)
# Copia este archivo como .env y reemplaza los valores CAMBIAR.
# Si una contraseña tiene caracteres especiales, codifícala en la URL (p. ej. @ -> %40).

NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Rol de aplicación (educore_app): solo SELECT/INSERT/UPDATE/DELETE.
DATABASE_URL=postgresql://educore_app:CAMBIAR@localhost:5432/educore_dev

# Rol dueño del esquema (educore_owner): solo lo usa el CLI de Prisma para migraciones.
DATABASE_MIGRATION_URL=postgresql://educore_owner:CAMBIAR@localhost:5432/educore_dev

# Orígenes del frontend autorizados por CORS, separados por comas.
WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=debug

# Documentación Swagger en /api/docs. Desactivada por defecto en producción.
SWAGGER_ENABLED=true

# Número de proxies inversos de confianza delante de la API (0 = ninguno).
TRUST_PROXY_HOPS=0

# Límite global de peticiones por IP.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# --- Autenticación ---
# Clave para firmar los tokens de acceso (mínimo 32 caracteres, aleatoria).
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CAMBIAR_POR_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_32_CARACTERES
# Duración del token de acceso (segundos) y de la sesión renovable (días).
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Duración máxima de una sesión aunque se renueve (días).
REFRESH_TOKEN_ABSOLUTE_TTL_DAYS=30
# Bloqueo de la cuenta tras intentos fallidos.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Intentos de login / recuperación por IP y minuto.
AUTH_RATE_LIMIT_MAX=10
# Cookie de sesión solo por HTTPS. Los navegadores aceptan localhost como seguro.
COOKIE_SECURE=true
# URL pública de la web (para los enlaces de los correos).
APP_PUBLIC_URL=http://127.0.0.1:5173

# --- Correo ---
# file: guarda los correos como .eml en MAIL_OUTBOX_DIR (desarrollo). smtp: envío real.
MAIL_DRIVER=file
MAIL_FROM=EduCore <no-responder@educore.local>
MAIL_OUTBOX_DIR=../../storage/dev-mail
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# --- Archivos ---
# Carpeta privada (fuera de Git; Apache la bloquea con .htaccess). Ruta relativa a apps/api.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=../../storage/files
