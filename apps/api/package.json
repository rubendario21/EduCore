{
  "name": "@educore/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de EduCore (NestJS + Prisma + PostgreSQL)",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "npm run deps:prepare && nest start --watch",
    "build": "npm run deps:prepare && nest build",
    "start": "node dist/main.js",
    "typecheck": "npm run deps:prepare && tsc --noEmit -p tsconfig.json",
    "test": "npm run deps:prepare && vitest run --project unit",
    "test:integration": "npm run deps:prepare && vitest run --project integration",
    "test:watch": "vitest --project unit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "deps:prepare": "npm run build -w @educore/shared && prisma generate",
    "setup:institution": "npm run build && node dist/cli/setup-institution.js"
  },
  "dependencies": {
    "@educore/shared": "0.1.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "dotenv": "18.0.8",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "read-excel-file": "9.3.12",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.18",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
