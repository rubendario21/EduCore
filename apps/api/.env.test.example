# EduCore API · Variables para pruebas de integración
# Copia este archivo como .env.test. Usa SIEMPRE la base educore_test:
# las pruebas de integración ejecutan migraciones y limpian datos en ella.

NODE_ENV=test
HOST=127.0.0.1
PORT=0
DATABASE_URL=postgresql://educore_app:CAMBIAR@localhost:5432/educore_test
DATABASE_MIGRATION_URL=postgresql://educore_owner:CAMBIAR@localhost:5432/educore_test
WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
LOG_LEVEL=silent
SWAGGER_ENABLED=false
TRUST_PROXY_HOPS=0
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=1000
JWT_ACCESS_SECRET=CAMBIAR_POR_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_32_CARACTERES
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_ABSOLUTE_TTL_DAYS=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_MAX=1000
COOKIE_SECURE=true
APP_PUBLIC_URL=http://127.0.0.1:5173
MAIL_DRIVER=memory
MAIL_FROM=EduCore <no-responder@educore.local>
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=../../storage/test-files
